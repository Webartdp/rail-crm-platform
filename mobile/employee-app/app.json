{
  "expo": {
    "name": "Rail CRM",
    "slug": "employee-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "railcrm",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#f4f6f9",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1c2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ua.in.ridnovir.railcrm",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ua.in.ridnovir.railcrm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1c2e"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rail CRM speichert beim Drücken einer Arbeitstaste (z. B. Dienstbeginn, Stop) Ihren Standort, damit die Arbeitszeit dem Einsatzort zugeordnet wird. Zu anderen Zeiten wird der Standort nicht erfasst."
        }
      ]
    ]
  }
}
